# Copie este arquivo para .env e informe sua chave.
AI_API_KEY=sua_chave_aqui
# Use o modelo do seu provedor. Com a OpenAI, o padrão é gpt-4o-mini.
# AI_MODEL=gpt-4o-mini
# Para outro provedor compatível com OpenAI Chat Completions:
# AI_BASE_URL=https://seu-provedor.example/v1

# Dificuldade: facil (A2/B1), equilibrado (B1/B2), avancado (B2/C1)
CARD_DIFFICULTY=equilibrado
# Quantidade de cards por palavra: 1, 2 ou 3
CARD_COUNT=2

ANKI_DECK=Inglês
ANKI_NOTE_MODEL=Omissão de Palavras
ANKI_URL=http://localhost:8765
# KINDLE_DB_PATH=C:/caminho/para/vocab.db
